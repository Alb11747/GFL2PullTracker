FROM node:24-bookworm-slim AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY backend/catalog.json /app/backend/catalog.json
COPY docs/IMPORTING.md /app/docs/IMPORTING.md
RUN npm run build && npm prune --omit=dev

FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/web/build ./build
COPY --from=build --chown=node:node /app/web/node_modules ./node_modules
COPY --from=build --chown=node:node /app/web/package.json ./package.json
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "require('http').get({hostname:'127.0.0.1',port:3000,path:'/api/health',headers:{host:new URL(process.env.ORIGIN).host,origin:process.env.ORIGIN},timeout:3000},r=>{r.resume();if(r.statusCode!==200)process.exit(1)}).on('timeout',()=>process.exit(1)).on('error',()=>process.exit(1))"
CMD ["node", "build"]
