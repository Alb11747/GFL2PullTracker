# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build
ARG POSTHOG_PROJECT_ID=
ARG GFL2_RELEASE=
WORKDIR /app/web
# The native source-map CLI uses the system trust store, unlike Node's bundled CAs.
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
COPY backend/catalog.json backend/banner_rules.json /app/backend/
COPY docs/IMPORTING.md /app/docs/IMPORTING.md
RUN --mount=type=secret,id=posthog_cli \
    if [ -n "$POSTHOG_PROJECT_ID" ]; then \
      test -s /run/secrets/posthog_cli && test -n "$GFL2_RELEASE" \
      && POSTHOG_SOURCEMAPS=1 npm run build \
      && POSTHOG_CLI_PROJECT_ID="$POSTHOG_PROJECT_ID" npx --no-install posthog-cli --dotenv-file /run/secrets/posthog_cli sourcemap inject --directory build --release-name GFL2PullTracker --release-version "$GFL2_RELEASE" --release-mode symbol-set \
      && POSTHOG_CLI_PROJECT_ID="$POSTHOG_PROJECT_ID" npx --no-install posthog-cli --dotenv-file /run/secrets/posthog_cli sourcemap upload --directory build --release-name GFL2PullTracker --release-version "$GFL2_RELEASE" --release-mode symbol-set --delete-after \
      && node scripts/compress-telemetry-assets.mjs; \
    else npm run build; fi \
    && find build -name '*.map' -type f -delete \
    && npm prune --omit=dev

FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/web/build ./build
COPY --from=build --chown=node:node /app/web/node_modules ./node_modules
COPY --from=build --chown=node:node /app/web/package.json ./package.json
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "require('http').get({hostname:'127.0.0.1',port:3000,path:'/api/health',headers:{host:new URL(process.env.ORIGIN).host,origin:process.env.ORIGIN,'x-real-ip':'127.0.0.1'},timeout:3000},r=>{r.resume();if(r.statusCode!==200)process.exit(1)}).on('timeout',()=>process.exit(1)).on('error',()=>process.exit(1))"
CMD ["node", "build"]
