FROM ghcr.io/astral-sh/uv:0.10.12 AS uv
FROM python:3.13-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" GFL2_DATA_DIR=/app/data
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && groupadd --gid 10001 tracker \
    && useradd --uid 10001 --gid tracker --no-create-home tracker \
    && mkdir /app/data && chown tracker:tracker /app/data
COPY backend ./backend
COPY scripts/fetch_pull_history.py scripts/backup_database.py ./scripts/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request, urllib.parse; origin=os.environ['PUBLIC_ORIGIN']; request=urllib.request.Request('http://127.0.0.1:8000/api/health', headers={'Host':urllib.parse.urlsplit(origin).netloc,'Origin':origin}); urllib.request.urlopen(request, timeout=3)"
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--no-proxy-headers", "--timeout-graceful-shutdown", "15"]
