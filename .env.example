# Exact HTTPS origin, no trailing slash or path. Required by public mode.
PUBLIC_ORIGIN=https://tracker.example.com
# Browser OAuth client ID, not a client secret. Leave blank to disable Drive connection.
PUBLIC_GOOGLE_CLIENT_ID=
# Public contact and operational disclosures shown on /privacy-policy.
PUBLIC_SUPPORT_EMAIL=
PUBLIC_HOSTING_DETAILS=
PUBLIC_LOG_RETENTION=
# Leave the project token blank to disable all analytics and diagnostics.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional API survey and stable question IDs for the About form (see docs/HOSTING.md).
PUBLIC_FEEDBACK_SURVEY_ID=
PUBLIC_FEEDBACK_CATEGORY_ID=
PUBLIC_FEEDBACK_MESSAGE_ID=
PUBLIC_FEEDBACK_EMAIL_ID=
# Set development, staging, or test for non-production public deployments.
GFL2_TELEMETRY_ENVIRONMENT=production
# When enabled, private source-map upload is required during image builds.
POSTHOG_PROJECT_ID=
# Set by the deployment script to the exact Git revision.
GFL2_RELEASE=
# Loopback-only frontend port for an existing reverse proxy.
# The proxy must overwrite X-Real-IP with its trusted client address; Compose
# fixes SvelteKit ADDRESS_HEADER=x-real-ip. Do not expose this port publicly.
WEB_PORT=3000
